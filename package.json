{
  "name": "lead-intelligence-system",
  "version": "1.0.0",
  "description": "CLI tool that qualifies inbound B2B leads against a weighted rubric and drafts personalized outreach with an LLM.",
  "main": "dist/src/main.js",
  "scripts": {
    "start": "ts-node src/main.ts --provider groq",
    "build": "tsc",
    "dry": "ts-node src/main.ts --dry-run --input data/leads.csv",
    "test:prompts": "ts-node test_prompts.ts --provider groq"
  },
  "keywords": [
    "leads",
    "qualification",
    "llm",
    "sales"
  ],
  "license": "MIT",
  "dependencies": {
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "js-yaml": "^4.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}

# Copy this file to `.env` and fill in a key. Never commit or zip the real `.env`.

# Groq — used by both `npm start` (prod) and `npm run test:prompts` (testing)
# Free tier: console.groq.com/keys
GROQ_API_KEY=
# Big model for the real submitted run. Overrides config.yaml's llm.model.
PROD_MODEL=openai/gpt-oss-120b
# Small/fast model for repeated test:prompts checks while iterating.
TEST_MODEL=openai/gpt-oss-20b

# Alternatives — only needed if you pass --provider openai / --provider gemini
# GEMINI_API_KEY=
# OPENAI_API_KEY=

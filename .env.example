# Copy this file to `.env` and fill in a key. Never commit or zip the real `.env`.
# Model names live only here — not in config.yaml or any source file — so
# swapping models (e.g. after a rate limit) is a one-line edit, nothing else.

# Groq — used by both `npm start` (prod) and `npm test` (quick 5-lead check)
# Free tier: console.groq.com/keys
GROQ_API_KEY=
PROD_MODEL=openai/gpt-oss-120b
# Used automatically if PROD_MODEL gets rate-limited. Optional — leave blank
# to just retry PROD_MODEL instead of switching models.
PROD_FALLBACK_MODEL=openai/gpt-oss-20b

# Alternatives — only needed if you pass --provider openai / --provider gemini
# (also pass --model, since PROD_MODEL above is a Groq-specific name)
# GEMINI_API_KEY=
# OPENAI_API_KEY=
